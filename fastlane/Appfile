# App Store identity. Values come from environment variables so no secrets live
# in git — see .env.appstore.example.
app_identifier("com.noqyris.foldwing")
apple_id(ENV["APPLE_ID"])            # Apple account email (App Store Connect)
team_id(ENV["APPLE_TEAM_ID"])        # Developer Portal Team ID — for signing
itc_team_id(ENV["ASC_TEAM_ID"])      # App Store Connect team id (usually same)
