# Foldwing — iOS release automation (Capacitor + fastlane).
#
# Auth is an App Store Connect API key, so no Apple-ID password or 2FA prompt.
# Set ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH, APPLE_ID, APPLE_TEAM_ID — see
# .env.appstore.example. Run from the project root:
#
#   npm run ios:sync            # web build + cap sync FIRST (see below)
#   fastlane verify             # does the API key work, does the app exist
#   fastlane setup_app          # create the App Store Connect record
#   fastlane beta               # archive + upload to TestFlight
#   fastlane release_build      # live-ads build, uploaded AND attached to
#                               # the editable version. Stops there — sending
#                               # it to Apple is a decision, not a lane.
#
# The web build and `cap sync` deliberately run in the shell BEFORE fastlane:
# CocoaPods misbehaves under fastlane's bundled Ruby, and forgetting the sync
# is the classic way to ship the previous build's UI inside a new binary.
default_platform(:ios)

WORKSPACE = "ios/App/App.xcworkspace"
SCHEME    = "App"
APP_ID    = "com.noqyris.foldwing"
TEAM      = "YMN45WC2QR"

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Verify API-key auth and whether the app record exists"
  lane :verify do
    key = asc_key
    begin
      n = latest_testflight_build_number(
        api_key: key, app_identifier: APP_ID, initial_build_number: 0
      )
      UI.success("AUTH OK — app exists. latest TestFlight build = #{n}")
    rescue => e
      UI.important("AUTH OK — but app lookup said: #{e.message}")
    end
  end

  desc "Create the App Store Connect app record if missing"
  # `produce` in this fastlane version has no api_key option. Calling asc_key
  # first still authenticates it: the action installs the token into
  # Spaceship::ConnectAPI globally, which produce then picks up — so this works
  # with the API key and never prompts for an Apple ID password or 2FA.
  lane :setup_app do
    asc_key
    # The App Store listing name must be globally unique and plain "Foldwing"
    # is already taken by someone else. This only affects the store listing —
    # CFBundleDisplayName is still "Foldwing", so the home-screen icon and the
    # in-game wordmark are unchanged. Rename in App Store Connect any time
    # before submission if you find something better.
    produce(
      app_identifier: APP_ID,
      app_name: "Foldwing: Mirror Puzzle",
      language: "English",
      app_version: "1.0",
      sku: "foldwing",
      company_name: "Djordje Subotic",
      team_id: TEAM
    )
  end

  # Google's test AdMob app id. Passed at archive time by :beta_testads and
  # never written to disk — the committed default in the pbxproj stays live, and
  # monetization.test.ts fails if this string ever appears in the project.
  GAD_TEST_APP_ID = "ca-app-pub-3940256099942544~1458002511"

  desc "Archive a signed App Store build"
  lane :build_ipa do |options|
    # PROVE WHAT IS ACTUALLY IN THE BUNDLE, not what a marker file remembers.
    #
    # TEST_ADS_MARKER records which npm script ran last. That is a claim about
    # history, and history goes stale: a hand-run `vite build` (or `npm run
    # build`, which is live by default) followed by `cap sync` replaces the web
    # assets underneath a marker that still says "test ads". The lane would then
    # archive live inventory and hand it to TestFlight, which is precisely how
    # publisher pub-3307486877162157 was closed for invalid traffic on
    # 2026-08-18 — an owner installs the newest TestFlight build and taps an ad
    # in what he believes is a test build.
    #
    # So the marker stays as the fast, friendly check and this reads the SYNCED
    # bundle — the exact JavaScript that goes inside the ipa — and refuses on a
    # mismatch. A check that can be skipped is not a check, so it lives here in
    # the archive path rather than in a script somebody remembers to run.
    want = options[:test_ads] ? "test" : "live"
    unless system("node", "scripts/check-ad-mode.mjs", want, "ios/App/App/public/assets")
      UI.user_error!("ad-mode check failed: the synced bundle does not carry #{want.upcase} ad units. Re-run the matching npm sync script.")
    end

    key = asc_key
    # Always land above whatever App Store Connect already has: a duplicate
    # build number is rejected after the upload has already been paid for.
    #
    # Written straight into CURRENT_PROJECT_VERSION rather than through
    # `increment_build_number`. That action shells out to agvtool, which also
    # rewrites any CFBundleVersion it finds in an Info.plist — including the
    # `$(CURRENT_PROJECT_VERSION)` reference that is there precisely so the
    # plist follows the build setting. It clobbered it back to a literal on the
    # build-20 upload, which would have reintroduced the drift the reference was
    # added to end (build 19 archived as 19 twice because the literal ignored
    # every increment). Xcodeproj touches the build setting and nothing else.
    latest = latest_testflight_build_number(api_key: key, app_identifier: APP_ID) rescue 0
    next_build = latest.to_i + 1
    # Relative to fastlane/, not to the project root: Xcodeproj resolves against
    # Ruby's cwd, unlike the fastlane actions around it, which resolve against
    # the root. Mixing the two conventions is a one-line, hard-to-spot break.
    #
    # MARKETING_VERSION comes from App Store Connect for the same reason.
    #
    # `CFBundleShortVersionString` must equal the store version the build is
    # submitted under. Build 36 was archived while the pbxproj still said 1.1
    # and submitted as 1.2, and App Store Connect answered INVALID_BINARY —
    # after the upload, after the review submission, with no warning at archive
    # time. Reading the number from the same place the submission reads it is
    # the only version of this that cannot drift.
    store_version = begin
      require "spaceship"
      # A real Spaceship token, NOT the hash `app_store_connect_api_key`
      # returns — assigning that silently breaks every call that follows, which
      # is how the first attempt reported "(unchanged)" and shipped 1.1 again.
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
      )
      app = Spaceship::ConnectAPI::App.find(APP_ID)
      edit = app.get_edit_app_store_version
      UI.user_error!("no editable App Store version to take a number from") unless edit
      edit.version_string
    end

    project = Xcodeproj::Project.open("../ios/App/App.xcodeproj")
    apply = lambda do |c|
      c.build_settings["CURRENT_PROJECT_VERSION"] = next_build.to_s
      c.build_settings["MARKETING_VERSION"] = store_version if store_version
    end
    project.build_configurations.each { |c| apply.call(c) }
    project.targets.each { |t| t.build_configurations.each { |c| apply.call(c) } }
    project.save
    # Hand the number to distribute_internally so it waits for THIS build
    # rather than for whatever App Store Connect happens to list first.
    ENV["FOLDWING_BUILD_NUMBER"] = next_build.to_s
    UI.message("build number -> #{next_build}")
    UI.message("marketing version -> #{store_version || '(unchanged)'}")

    # Fetch (or create) the App Store profile through the ASC API, then sign
    # MANUALLY against it.
    #
    # Automatic signing fails here with "Cloud signing permission error / No
    # profiles for com.noqyris.foldwing were found": Xcode's cloud signing needs
    # rights on the API key that this one does not have. Spaceship talks to the
    # Developer Portal over a different path and can create the profile fine, so
    # sigh gets it and the export just uses it. No browser, no Xcode UI.
    profile = get_provisioning_profile(
      api_key: key,
      app_identifier: APP_ID,
      development: false,
      readonly: false
    )
    UI.message("signing with profile: #{profile}")

    # The AdMob app id is a build setting the plist references, so a test-ads
    # archive overrides it here and leaves the working tree untouched.
    args = ["-allowProvisioningUpdates"]
    if options[:test_ads]
      UI.important("TEST ADS: overriding GAD_APPLICATION_IDENTIFIER for this archive only")
      args << "GAD_APPLICATION_IDENTIFIER=#{GAD_TEST_APP_ID}"
    end

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      output_name: "Foldwing.ipa",
      xcargs: args.join(" "),
      export_options: {
        signingStyle: "manual",
        teamID: TEAM,
        provisioningProfiles: { APP_ID => profile }
      }
    )
  end

  # Which kind of web bundle is currently synced into the native shell.
  #
  # The JavaScript half (which ad UNITS to request) and the native half (which
  # AdMob APP the SDK reports to) have to agree, and they are set by two
  # different commands. The npm scripts drop or clear this marker so the lane
  # can refuse a mismatch instead of discovering it after a tester reports
  # blank space. build/ is gitignored, so it can never be committed.
  TEST_ADS_MARKER = "../build/.test-ads"

  desc "REMOVED — it distributed real ads to testers. Use beta_testads or release_build."
  # This lane built with LIVE ad units and handed the result straight to the
  # internal tester group. That is the exact act that closed publisher
  # pub-3307486877162157 for invalid traffic on 2026-08-18: builds 42 through 45
  # went to TestFlight carrying real inventory, on the account owner's own phone.
  #
  # It is kept as a refusal rather than deleted. `fastlane beta` is muscle memory
  # and the name is in old notes and shell history; deleting it produces "lane
  # not found", which reads like breakage and invites someone to reconstruct it.
  # A lane that explains why it is gone cannot be rebuilt by accident.
  #
  # There is no remaining case for it. Real ads exist to be sold to strangers,
  # never shown to testers, so the two live paths are:
  #
  #   test ads  -> testers      `npm run ios:testflight && fastlane beta_testads`
  #   real ads  -> App Store    `npm run release:appstore`
  lane :beta do
    UI.user_error!(<<~MSG)
      `beta` is gone: it put REAL ad units on TestFlight, which is what closed
      pub-3307486877162157 on 2026-08-18.

        for testers:    npm run ios:testflight && fastlane beta_testads
        for the store:  npm run release:appstore

      release:appstore uploads the real-ads build AND follows it with a test-ads
      build, so the newest thing on TestFlight is never the one with real ads.
    MSG
  end

  desc "TestFlight build that SHOWS ADS — test units. Never submit one of these."
  # Live units return no-fill until AdMob has reviewed the app, and AdMob only
  # reviews once the app is PUBLIC on the store, so a tester on a live build
  # sees blank space and cannot judge placement or frequency at all. Test units
  # render immediately.
  #
  # Test ads are now the DEFAULT of the web bundle (VITE_AD_MODE unset), and
  # GAD_APPLICATION_IDENTIFIER is overridden for this archive only, on the
  # xcodebuild command line. Nothing is written to the working tree, so the next
  # ordinary `fastlane beta` is a submission build again with no cleanup step to
  # forget — which is the step that was forgotten before build 19.
  lane :beta_testads do
    unless File.exist?(TEST_ADS_MARKER)
      UI.user_error!("dist/ was not built with test ads — run `npm run ios:sync:testads` first")
    end
    build_ipa(test_ads: true)
    upload_and_distribute
    UI.important("Uploaded with TEST ADS — for TestFlight only, never submit it.")
    UI.important("The working tree is untouched and still submission-ready.")
  end

  # Upload, then hand the build to the internal group — as two separate steps,
  # deliberately.
  #
  # `upload_to_testflight(groups:)` looks like the obvious way to do this and is
  # a trap: pilot's distribute path calls post_beta_app_review_submission, so
  # asking it to distribute ASKS APPLE TO REVIEW THE BUILD. On build 24 that
  # fired and only failed because the Beta App Description was empty — an
  # accident is the only reason a test-ads build was not sent to Apple.
  #
  # `Build#add_beta_groups` is the plain distribution call and touches no review
  # queue, so distribution goes through that and never through pilot.
  #
  # Without it the build sits at processing=VALID,
  # internal=READY_FOR_BETA_TESTING and never reaches a phone. That happened to
  # builds 19 through 23, and then AGAIN to builds 36 through 41, because the
  # step was left as a printed reminder to run `asc-tf-groups assign` by hand
  # and nobody ran it. A reminder is not automation: six builds were uploaded,
  # submitted and argued about while the last thing anyone could actually
  # install was build 35. So it happens here, in the lane, every time.
  def upload_and_distribute
    upload_to_testflight(
      api_key: asc_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
    distribute_internally
  end

  # Wait for the build Apple is still processing, then hand it to the internal
  # group. Uploading returns long before the build is installable, which is why
  # this polls rather than assuming.
  #
  # It waits for THIS build by number, not for "the newest valid one". Those are
  # not the same thing in the minutes after an upload: App Store Connect has not
  # listed the new build yet, so the newest it can see is the PREVIOUS one,
  # which is already VALID. The first version of this handed build 41 to the
  # testers and announced it had shipped build 42.
  def distribute_internally
    expected = ENV["FOLDWING_BUILD_NUMBER"]
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    groups = app.get_beta_groups.select(&:is_internal_group)
    if groups.empty?
      UI.important("No internal group on this app — nothing to distribute to.")
      return
    end

    build = nil
    20.times do
      candidates = app.get_builds(sort: "-version")
      found = expected ? candidates.find { |b| b.version == expected } : candidates.first
      if found && found.processing_state == "VALID"
        build = found
        break
      end
      UI.message("build #{expected || found&.version} is #{found&.processing_state || 'not listed yet'}; waiting")
      sleep(45)
    end
    unless build
      UI.important("Build #{expected} still processing after 15 minutes.")
      UI.important("Finish with: asc-tf-groups assign --app #{APP_ID}")
      return
    end

    build.add_beta_groups(beta_groups: groups)
    UI.success("build #{build.version} handed to #{groups.map(&:name).join(', ')} — installable now")
  end

  desc "Live-ads build, uploaded and ATTACHED to the editable App Store version. Does not submit."
  # THE SUBMISSION BUILD. Everything up to the point where a human says go.
  #
  # This exists because the version record kept pointing at a stale binary.
  # Version 1.3 sat with build 41 attached — uploaded before the opening film,
  # the store, the music, Game Center, the achievements and the reminders were
  # written — while six newer builds went past it. Nothing in the process
  # updated the attachment, because attaching was a thing somebody did by hand
  # in the web UI, and a manual step in a release is a step that eventually does
  # not happen. That is the same failure that left builds 36-41 undistributed,
  # and the fix is the same: put it in the lane.
  #
  # The hazard is worse here than a missing tester build. Release notes describe
  # the newest work, so a stale attachment means the notes promise features the
  # reviewed binary does not contain — which is not a silent problem, it is a
  # rejection with the app's own changelog as the evidence.
  #
  # IT UPLOADS BUT DOES NOT DISTRIBUTE — AND THAT IS NOT ENOUGH ON ITS OWN.
  #
  # This lane hands the build to no group: `upload_and_distribute` is not used
  # and no add_beta_groups call happens. On THIS app that does keep it off
  # testers' phones — Foldwing's only internal group reports
  # hasAccessToAllBuilds=false (verified against the API on 2026-08-18), so an
  # unassigned build is not offered to it.
  #
  # Do not lean on that. It is a per-app setting nobody here chose deliberately,
  # it is `true` on other apps in this portfolio, and CLAUDE.md assumes the
  # dangerous value on purpose. A safety property that depends on a flag no
  # release step asserts is not a safety property.
  #
  # So the real protection is the SECOND UPLOAD, not the missing group
  # assignment: `npm run release:appstore` follows this lane with a test-ads
  # build N+1, which becomes the newest thing on TestFlight. Running this lane
  # alone leaves a real-ads binary as the newest build, which is the state that
  # closed pub-3307486877162157 on 2026-08-18.
  #
  # IT DOES NOT SUBMIT, AND THAT IS THE POINT. The last step of a release is a
  # decision, not a task. This lane stops with the version armed and the build
  # in place; sending it to Apple stays a separate, deliberate act.
  lane :release_build do
    if File.exist?(TEST_ADS_MARKER)
      UI.user_error!("dist/ holds a TEST ADS bundle — a store build must never carry test units. Run `npm run ios:sync` first.")
    end
    UI.important("=" * 68)
    UI.important("This build carries REAL AD UNITS.")
    UI.important("After processing it becomes a build on TestFlight. Do NOT open it,")
    UI.important("and do NOT tap an ad in it — that is the invalid traffic that closed")
    UI.important("pub-3307486877162157 on 2026-08-18.")
    UI.important("=" * 68)

    build_ipa
    upload_to_testflight(
      api_key: asc_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
    attach_to_version

    # Half a release. Say so, every time, so a session that stops here is
    # obviously unfinished rather than quietly unsafe.
    UI.important("=" * 68)
    UI.important("HALF DONE. A real-ads build is now the newest upload.")
    UI.important("Finish with:  npm run ios:testflight && fastlane beta_testads")
    UI.important("(`npm run release:appstore` does both halves in one command.)")
    UI.important("=" * 68)
  end

  # Wait for the build just uploaded, then point the editable version at it.
  #
  # Waits for THIS build by number for the same reason distribute_internally
  # does: in the minutes after an upload the newest build App Store Connect can
  # see is still the previous one, so "attach the latest" would attach the
  # wrong binary and look like it had worked.
  def attach_to_version
    expected = ENV["FOLDWING_BUILD_NUMBER"]
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)

    build = nil
    20.times do
      candidates = app.get_builds(sort: "-version")
      found = expected ? candidates.find { |b| b.version == expected } : candidates.first
      if found && found.processing_state == "VALID"
        build = found
        break
      end
      UI.message("build #{expected || found&.version} is #{found&.processing_state || 'not listed yet'}; waiting")
      sleep(45)
    end
    unless build
      UI.important("Build #{expected} still processing. Re-run `fastlane attach_build` once it is VALID.")
      return
    end

    version = app.get_edit_app_store_version
    if version.nil?
      UI.important("No editable App Store version — create one in App Store Connect, then run `fastlane attach_build`.")
      return
    end

    version.select_build(build_id: build.id)
    UI.success("version #{version.version_string} now points at build #{build.version}")
    UI.important("NOT submitted for review. That is a separate, deliberate step.")
  end

  desc "Point the editable App Store version at an already-uploaded build"
  # The recovery path for when the upload landed but the attach did not — a
  # timeout, a version that did not exist yet, a build still processing.
  # FOLDWING_BUILD_NUMBER picks the build; without it, the newest VALID one.
  lane :attach_build do
    attach_to_version
  end

  desc "Expire a TestFlight build so nobody can install it. Does NOT affect the App Store."
  # Step 3 of the two-build release, and the only one that had no command.
  #
  # Once the store build reaches READY_FOR_SALE it has done its job, but it is
  # still sitting in TestFlight carrying real ad units. Expiring removes it from
  # the tester list without touching the store listing — verified on
  # com.noqyris.kvizko build 51, which was simultaneously READY_FOR_SALE for 1.2
  # and expired:true on TestFlight.
  #
  #   fastlane expire_build build:52
  #
  # Without `build:` it expires the newest one, which is almost never what is
  # wanted — so it refuses instead of guessing.
  lane :expire_build do |options|
    number = options[:build] or UI.user_error!("which build? e.g. `fastlane expire_build build:52`")
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    build = app.get_builds(sort: "-version").find { |b| b.version == number.to_s }
    UI.user_error!("no build #{number} on this app") unless build
    if build.expired
      UI.success("build #{number} is already expired")
      next
    end

    # Spaceship's own call. A hand-rolled PATCH here took keyword args against a
    # positional signature and would have thrown on first use.
    build.expire!
    UI.success("build #{number} expired — no longer installable from TestFlight")
    UI.message("The App Store listing is untouched.")
  end

  desc "Re-upload the ipa already in build/ without rebuilding"
  # Apple's uploader returns a 500 often enough to matter, and rebuilding would
  # burn another build number for a transfer that never reached them.
  lane :beta_upload do
    upload_to_testflight(
      api_key: asc_key,
      ipa: "build/Foldwing.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
