require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityInAppReview', :path => '../../node_modules/@capacitor-community/in-app-review'
  pod 'CapacitorFilesystem', :path => '../../node_modules/@capacitor/filesystem'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPreferences', :path => '../../node_modules/@capacitor/preferences'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
  pod 'CapacitorLevelplayAds', :path => '../../node_modules/capacitor-levelplay-ads'
  pod 'CordovaPlugins', :path => '../capacitor-cordova-ios-plugins'
end

target 'App' do
  capacitor_pods
  # Add your Pods here

  # The ad SDK versions, pinned to what KVIZKO runs in production on iOS:
  # IronSourceSDK 9.6.0.0 with IronSourceUnityAdsAdapter 5.11.0.0 and
  # UnityAds 4.20.0. The adapter is not named here on purpose. Each adapter
  # release pins UnityAds exactly (5.11.0.0 wants = 4.20.0, 5.12.0.0 wants
  # = 4.20.1), so pinning UnityAds is what makes the resolver land on 5.11.0.0.
  # The adapter itself is written UNVERSIONED by the capacitor:sync:after hook
  # (capacitor-levelplay-ads/scripts/levelplay-manifest.js) into the
  # LEVELPLAY-ADAPTERS block below, and the hook rewrites that block on every
  # cap sync: a version written inside it is silently erased on the next sync.
  # These two lines sit outside the block, where it cannot reach them.
  #
  # Podfile.lock pins everything else, but a lock only holds until somebody
  # deletes it or runs pod update. Move these numbers deliberately, together,
  # and build before trusting the result: an ad SDK that compiles is not an ad
  # SDK that fills.
  pod 'IronSourceSDK', '9.6.0.0'
  pod 'UnityAds', '4.20.0'
  # LEVELPLAY-ADAPTERS:BEGIN (generated by levelplay-manifest.js)
  pod 'IronSourceUnityAdsAdapter'
  # LEVELPLAY-ADAPTERS:END
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
