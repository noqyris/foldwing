	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<!-- Portrait only, iPhone only (TARGETED_DEVICE_FAMILY = 1).
	     The mirror axis is vertical and the playfield is authored 9:16, so
	     landscape would make the drawable half unusable. Apple rejects an
	     iPad-capable build that does not offer all four orientations (90474),
	     and offering them would mean shipping an orientation the game cannot
	     be played in — so the app drops iPad instead of dropping portrait. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- The app uses no encryption beyond what Apple exempts (HTTPS). Declaring
	     it here means TestFlight and App Store uploads stop asking on every
	     single build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- AdMob application id. This is a NATIVE value the SDK reads at launch, so
	     it cannot follow a TypeScript flag — it has to be edited by hand and it
	     has to agree with monetization.useTestAds.

	     TEST (current): ca-app-pub-3940256099942544~1458002511
	     LIVE:           ca-app-pub-3307486877162157~5033197766

	     Getting these out of step is a policy problem in either direction, so
	     it is not left to memory: monetization.test.ts reads this file and
	     fails the build if the id here does not match the flag. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3307486877162157~5033197766</string>

	<!-- App Tracking Transparency. Shown before the UMP consent form; declining
	     is fine and simply serves non-personalised ads. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Allows Foldwing to show ads that are more relevant to you. Declining keeps the ads, just less relevant.</string>

