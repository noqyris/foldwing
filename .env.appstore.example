# App Store Connect API key auth. Copy to .env.appstore (gitignored) and fill in.
# The key itself lives in ~/.appstoreconnect/private_keys and is NEVER committed.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
APPLE_ID=
APPLE_TEAM_ID=YMN45WC2QR
ASC_TEAM_ID=
